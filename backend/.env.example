# Backend environment configuration.
# Copy this file to ".env" and adjust the values for your environment.

# Database connection string.
# Use host "db" when running inside docker-compose (matches the compose service name).
# Use host "localhost" when running the backend directly on your machine.
DATABASE_URL=postgresql://postgres:postgres@db:5432/ticketing

# Secret key used to sign JWT access tokens.
# OVERRIDE THIS with a long, random value in any real deployment.
SECRET_KEY=dev-secret-change-me-please-override-in-production

# Access token lifetime in minutes (1440 = 24 hours).
ACCESS_TOKEN_EXPIRE_MINUTES=1440

# Allowed CORS origins. Accepts a comma-separated list (no spaces required)
# or a JSON-style list. Defaults cover the Vite dev server and a common alt port.
BACKEND_CORS_ORIGINS=http://localhost:5173,http://localhost:3000
