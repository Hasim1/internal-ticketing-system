# ---------------------------------------------------------------------------
# Root environment file for docker-compose.
# Copy this file to `.env` and adjust values before running `docker compose up`.
#   cp .env.example .env
# NEVER commit the real `.env` (it is git-ignored).
# ---------------------------------------------------------------------------

# --- PostgreSQL (used by the `db` service and to build DATABASE_URL) ---
POSTGRES_USER=postgres
POSTGRES_PASSWORD=postgres
POSTGRES_DB=ticketing

# --- Backend / FastAPI ---
# JWT signing secret. CHANGE THIS to a long random string in any real deployment.
SECRET_KEY=change-me

# Access token lifetime in minutes (1440 = 24h).
ACCESS_TOKEN_EXPIRE_MINUTES=1440

# Allowed CORS origins for the browser frontend (JSON array string).
BACKEND_CORS_ORIGINS=["http://localhost:5173","http://localhost:3000"]

# --- Frontend (Vite) ---
# Baked into the static bundle at build time; points the SPA at the backend API.
VITE_API_URL=http://localhost:8000/api
